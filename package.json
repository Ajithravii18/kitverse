{
  "name": "kitverse-mern",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:client": "vite --host",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "test": "cross-env NODE_ENV=test node --test server/*.test.js",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@studio-freight/lenis": "^1.0.42",
    "bcrypt": "^6.0.0",
    "connect-mongo": "^6.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.52.0",
    "mongoose": "^8.19.0",
    "nodemailer": "^10.0.11",
    "razorpay": "^2.9.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "mongodb-memory-server": "^11.3.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
