@charset "utf-8";

.hero-letter-mask { display: inline-block; overflow: clip; vertical-align: top; padding-bottom: 0.08em; margin-bottom: -0.08em; }

.hero-letter { display: inline-block; }

[data-hero-title] { white-space: nowrap; }

[data-hero-frame] > img { transform-origin: center center; }

.home-marquee { --marquee-paper: #e9f800; --marquee-ink: #1c1b1c; background: var(--marquee-paper); color: var(--marquee-ink); padding: 16px 0px 24px; margin: 24px 0px 48px; overflow: hidden; min-width: 0px; width: 100%; }

.home-marquee--dark { --marquee-paper: #1c1b1c; --marquee-ink: #e9f800; }

.home-marquee--paper { --marquee-paper: #fcf8f9; border-block: 1px solid rgb(28, 27, 28); }

.home-marquee-meta { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 0px 40px 18px; font: 10px / 1.4 "Space Mono", monospace; text-transform: uppercase; letter-spacing: 0.12em; }

.home-marquee-meta button { color: inherit; background: transparent; border: 1px solid; padding: 8px 12px; font: inherit; white-space: nowrap; }

.home-marquee-meta button:focus-visible { outline: currentcolor solid 2px; outline-offset: 4px; }

.home-marquee-window { overflow: hidden; }

.home-marquee-track { display: flex; width: max-content; animation: 70s linear 0s infinite normal none paused home-marquee-loop; }

.home-marquee[data-running="true"] .home-marquee-track { animation-play-state: running; }

.home-marquee[data-reverse="true"] .home-marquee-track { animation-direction: reverse; animation-duration: 82s; }

.home-marquee:hover .home-marquee-track, .home-marquee:focus-within .home-marquee-track { animation-play-state: paused; }

.home-marquee-group { display: flex; align-items: center; flex-shrink: 0; }

.home-marquee-item { display: flex; align-items: center; gap: 36px; padding-right: 36px; white-space: nowrap; font: 800 clamp(28px, 4vw, 60px) / 1.12 Syne, sans-serif; letter-spacing: -0.045em; }

.home-marquee-star { font-size: 0.65em; font-weight: 400; }

@keyframes home-marquee-loop { 
  100% { transform: translateX(-50%); }
}

@media (max-width: 640px) {
  .home-marquee { padding-block: 12px 20px; margin-block: 16px 32px; }
  .home-marquee-meta { padding: 0px 20px 16px; font-size: 9px; }
  .home-marquee-item { gap: 20px; padding-right: 20px; }
}

@media (prefers-reduced-motion: reduce) {
  .home-marquee-track { animation: auto ease 0s 1 normal none running none; width: 100%; }
  .home-marquee-group { flex-wrap: wrap; justify-content: center; gap: 12px; width: 100%; padding: 0px 20px; }
  .home-marquee-group[aria-hidden="true"], .home-marquee-meta button { display: none; }
  .home-marquee-item { white-space: normal; font-size: clamp(22px, 4vw, 48px); }
}

.home-page { overflow-x: clip; }

.home-page main, .home-page main > div { min-width: 0px; }

.home-page > header { padding: 12px 0px; }

.home-page > header > div { height: auto; gap: 12px; }

.home-page > header nav { min-width: 0px; overflow-x: auto; }

.home-page > header nav a { flex: 0 0 auto; white-space: nowrap; }

.home-page > header nav a:first-child { display: block; }

.home-page > header > div > div:last-child > div { display: none; }

@media (max-width: 767px) {
  .home-page > header > div { padding-inline: 20px; }
  .home-page > header > div > div:first-child > div:first-child > span:last-child { display: none; }
  .home-page > header > div > div:first-child > div:last-child { gap: 10px; }
  .home-page > header .font-headline-sm { font-size: 18px; white-space: nowrap; }
  .home-page > header .font-price-currency { font-size: 10px; white-space: nowrap; }
  .home-page > header nav { gap: 20px; padding-block: 4px; }
  .home-page .px-margin-desktop { padding-inline: 20px; }
  .home-page h1 { font-size: clamp(28px, 9vw, 68px); line-height: 1.1; }
  .home-page h2 { font-size: clamp(26px, 6.5vw, 42px); overflow-wrap: anywhere; }
}
