.bestseller-hover-inspect { position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%) translateY(14px); opacity: 0; background: var(--ink); color: rgb(255, 255, 255); font-size: 11px; font-weight: 800; letter-spacing: 0.8px; padding: 6px 14px; border-radius: 0px; white-space: nowrap; pointer-events: none; transition: 0.25s; }

