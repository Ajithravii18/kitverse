.hero-spec-btn { background: var(--lime); color: var(--ink); border: 0px; padding: 6px 13px; border-radius: 0px; font-size: 11px; font-weight: 800; cursor: pointer; display: inline-flex; align-items: center; gap: 4px; transition: 0.2s; }

