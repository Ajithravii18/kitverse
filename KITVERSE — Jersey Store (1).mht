.quality-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }

.quality-grid article { background: rgba(255, 255, 255, 0.035); border: 1.5px solid rgba(255, 255, 255, 0.12); border-radius: 0px; padding: 30px 26px; display: flex; flex-direction: column; transition: 0.3s cubic-bezier(0.2, 0.8, 0.2, 1); box-shadow: rgba(0, 0, 0, 0.2) 0px 4px 20px; }

.quality-grid article:hover { background: rgba(255, 255, 255, 0.067); border-color: var(--lime); transform: translateY(-4px); box-shadow: rgba(0, 0, 0, 0.38) 0px 14px 36px, rgba(193, 255, 56, 0.25) 0px 0px 0px 1px; }

