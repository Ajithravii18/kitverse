.bestseller-img-stage { position: relative; width: 100%; aspect-ratio: 1 / 1; background: rgb(241, 243, 237); border-width: 0px 0px 1.5px; border-style: none none solid; border-color: currentcolor currentcolor rgb(225, 230, 217); border-image: none; padding: 24px; cursor: pointer; display: flex; align-items: center; justify-content: center; overflow: hidden; transition: border-color 0.3s; }

