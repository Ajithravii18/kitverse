.teams-nav-arrow { position: absolute; top: 50%; transform: translateY(-50%); width: 44px; height: 44px; border-radius: 50%; background: rgb(24, 26, 22); color: rgb(255, 255, 255); border: 2px solid rgb(24, 26, 22); display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 10; box-shadow: rgba(0, 0, 0, 0.22) 0px 6px 18px; transition: 0.2s cubic-bezier(0.2, 0.8, 0.2, 1); }

