.team-item { background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0px; cursor: pointer; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px; width: 152px; flex-shrink: 0; outline: none; transition: transform 0.2s; }

.team-circle-stage { width: 98px; height: 98px; border-radius: 50%; background: rgb(255, 255, 255); border: 1.5px solid rgb(236, 239, 232); box-shadow: rgba(0, 0, 0, 0.04) 0px 4px 18px; display: flex; align-items: center; justify-content: center; position: relative; transition: 0.25s cubic-bezier(0.2, 0.8, 0.2, 1); }

