.hero-stage { position: relative; background: rgb(255, 255, 255); overflow: hidden; min-width: 0px; outline: none; display: flex; flex-direction: column; justify-content: space-between; user-select: none; border-left: 1.5px solid rgb(212, 217, 204); }

.hero-ambient-glow { position: absolute; inset: 0px; pointer-events: none; transition: background 0.8s cubic-bezier(0.2, 0.8, 0.2, 1); z-index: 1; mix-blend-mode: multiply; }

.hero-watermark-text { position: absolute; top: 42%; left: 50%; transform: translate(-50%, -50%); font-family: "Barlow Condensed", sans-serif; font-size: clamp(140px, 18vw, 240px); font-weight: 900; color: rgba(0, 0, 0, 0.04); letter-spacing: -6px; pointer-events: none; z-index: 1; user-select: none; line-height: 1; transition: 0.5s; }

.hero-stage-top { position: relative; z-index: 4; display: flex; justify-content: space-between; align-items: center; padding: 24px 28px 0px; gap: 12px; }

.hero-status-pill { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); padding: 7px 14px; border-radius: 0px; font-size: 11px; font-weight: 800; letter-spacing: 0.6px; color: var(--ink); display: flex; align-items: center; gap: 8px; box-shadow: rgba(0, 0, 0, 0.05) 0px 2px 10px; border: 1.5px solid rgb(212, 217, 204); }

