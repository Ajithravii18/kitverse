.teams-active-filter { display: inline-flex; align-items: center; gap: 10px; background: rgb(240, 243, 235); border: 1px solid rgb(212, 217, 204); padding: 6px 14px; font-size: 13px; font-weight: 600; color: var(--ink); }

.teams-clear-btn { background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; font-weight: 800; text-decoration: underline; cursor: pointer; color: rgb(201, 24, 74); padding: 0px 4px; font-size: 13px; }

