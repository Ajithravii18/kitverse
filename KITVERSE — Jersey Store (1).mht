.hero-counter-wrap { display: flex; align-items: center; gap: 5px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); padding: 6px 14px; border-radius: 0px; font-family: "Barlow Condensed", sans-serif; font-size: 14px; font-weight: 800; color: var(--ink); border: 1.5px solid rgb(212, 217, 204); box-shadow: rgba(0, 0, 0, 0.05) 0px 2px 10px; }

