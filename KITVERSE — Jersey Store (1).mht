.hero-stage:hover .hero-stage-arrow { opacity: 1; pointer-events: auto; }

.hero-stage-arrow:hover { background: var(--lime); border-color: var(--lime); transform: translateY(-50%); box-shadow: rgba(0, 0, 0, 0.15) 0px 6px 18px; }

.hero-stage-prev { left: 18px; }

.hero-stage-next { right: 18px; }

.hero-spec-card { position: absolute; bottom: 24px; left: 24px; z-index: 4; background: rgba(18, 20, 16, 0.94); backdrop-filter: blur(16px); color: rgb(255, 255, 255); padding: 16px 20px; border-radius: 0px; border: 1.5px solid rgba(255, 255, 255, 0.2); box-shadow: rgba(0, 0, 0, 0.35) 0px 16px 40px; max-width: 290px; transition: transform 0.3s, border-color 0.3s; }

