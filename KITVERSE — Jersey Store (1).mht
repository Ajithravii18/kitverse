.bestseller-add-btn { background: var(--lime); color: var(--ink); border: 1px solid rgba(24, 26, 22, 0.12); padding: 7px 14px; font-size: 12px; font-weight: 800; border-radius: 0px; cursor: pointer; display: inline-flex; align-items: center; gap: 5px; transition: 0.2s; box-shadow: rgba(193, 255, 56, 0.25) 0px 2px 6px; }

