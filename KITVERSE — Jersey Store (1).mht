@charset "utf-8";

.reveal { opacity: 0; transform: translateY(24px); transition-behavior: normal, normal; transition-duration: 0.55s, 0.55s; transition-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1), cubic-bezier(0.2, 0.8, 0.2, 1); transition-property: opacity, transform; transition-delay: calc(var(--i, 0) * 0.07s); }

.reveal.is-visible { opacity: 1; transform: translateY(0px); }

section.reveal { --i: 0; transition-duration: 0.65s; }

.bestseller-card.reveal, .product.reveal { transition-delay: calc(var(--i, 0) * 0.06s); }

.quality-grid article.reveal { transition-delay: calc(var(--i, 0) * 0.1s); }

@media (prefers-reduced-motion: reduce) {
  .reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
}

@keyframes skeletonPulse { 
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.skeleton-product { background: rgb(236, 238, 231); border-radius: 0px; animation: 1.4s ease-in-out 0s infinite normal none running skeletonPulse; }

.skeleton-product-img { width: 100%; aspect-ratio: 4 / 5; background: rgb(224, 227, 218); }

.skeleton-product-text { padding: 14px; display: flex; flex-direction: column; gap: 10px; }

.skeleton-product-line { height: 13px; border-radius: 3px; background: rgb(212, 215, 206); }

.product { transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1); }

.product:hover { transform: translateY(-6px); }

.product-image { transition: box-shadow 0.3s; }

.product:hover .product-image { box-shadow: rgba(24, 26, 22, 0.14) 0px 16px 40px; }

.primary:active { transform: scale(0.97); }

.bestseller-add-btn:active { transform: scale(0.95); }

@keyframes slideDown { 
  0% { opacity: 0; transform: translateY(-100%); }
  100% { opacity: 1; transform: translateY(0px); }
}

.announcement { animation: 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) 0s 1 normal both running slideDown; }

@keyframes headerReveal { 
  0% { opacity: 0; transform: translateY(-12px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.site-header { animation: 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) 0.1s 1 normal both running headerReveal; }

.quality-grid article { transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.3s, border-color 0.3s, background 0.3s; }

.page-loading-overlay { position: fixed; inset: 0px; background: var(--paper); z-index: 9999; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 24px; animation: 0.5s ease 0.8s 1 normal both running fadeOutOverlay; }

@keyframes fadeOutOverlay { 
  100% { opacity: 0; pointer-events: none; }
}

.loading-logo { font-family: "Barlow Condensed", "Arial Narrow", sans-serif; font-size: 56px; font-weight: 900; font-style: italic; letter-spacing: -2px; color: var(--ink); animation: 0.9s ease-in-out 0s infinite alternate none running logoPulse; }

@keyframes logoPulse { 
  0% { opacity: 0.4; }
  100% { opacity: 1; }
}

.loading-bar-wrap { width: 120px; height: 3px; background: rgb(224, 227, 218); overflow: hidden; }

.loading-bar { height: 100%; background: var(--lime); animation: 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0s 1 normal both running loadBar; }

@keyframes loadBar { 
  0% { width: 0px; }
  100% { width: 100%; }
}

.chips button { transition: background 0.18s, border-color 0.18s, color 0.18s, transform 0.15s; }

.chips button:active { transform: scale(0.95); }

@keyframes toastIn { 
  0% { opacity: 0; transform: translateX(-50%) translateY(20px); }
  100% { opacity: 1; transform: translateX(-50%) translateY(0px); }
}

#toast[style*="block"] { animation: 0.3s cubic-bezier(0.2, 0.8, 0.2, 1) 0s 1 normal both running toastIn; }

.team-item:active .team-circle-stage { transform: scale(0.94); }

.ticker { position: relative; }

@keyframes shieldFlip { 
  0% { transform: perspective(400px) rotateY(0deg) scale(0.9); opacity: 0.6; }
  50% { transform: perspective(400px) rotateY(180deg) scale(1.1); opacity: 1; filter: drop-shadow(rgb(193, 255, 56) 0px 0px 12px); }
  100% { transform: perspective(400px) rotateY(360deg) scale(0.9); opacity: 0.6; }
}

.loading-pulse { animation: 1.4s cubic-bezier(0.2, 0.8, 0.2, 1) 0s infinite normal none running shieldFlip; color: rgb(193, 255, 56); }

.pamidor-list:hover > .pamidor-item { opacity: 0.3; transition: opacity 0.4s cubic-bezier(0.2, 0.8, 0.2, 1); }

.pamidor-list > .pamidor-item:hover { opacity: 1; }

.pamidor-item { transition: opacity 0.4s cubic-bezier(0.2, 0.8, 0.2, 1); }
