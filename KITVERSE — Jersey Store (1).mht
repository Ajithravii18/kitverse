.teams-nav-next { right: -8px; }

.teams-track { display: grid; grid-auto-flow: column; grid-template-rows: repeat(2, auto); gap: 28px 24px; overflow-x: auto; scroll-behavior: smooth; scrollbar-width: none; padding: 14px 28px; width: 100%; }

